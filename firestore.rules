rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isMember(vault) {
      return signedIn() && request.auth.uid in vault.memberUids;
    }

    // Vault id equals the owner's uid. Only members can read it; strangers cannot list vaults.
    match /vaults/{vaultId} {
      allow get: if signedIn()
        && (resource == null ? vaultId == request.auth.uid : request.auth.uid in resource.data.memberUids);
      allow list: if false;

      allow create: if signedIn()
        && vaultId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if isMember(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          resource.data.ownerUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
        );

      // A new member joins by presenting an invite key that the owner created.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'joinKey', 'updatedAt'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinKey)).data.vaultId == vaultId;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /recipes/{recipeId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/vaults/$(vaultId)).data);
      }
    }

    match /invites/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.vaultId == request.auth.uid;
      allow delete: if signedIn() && resource.data.vaultId == request.auth.uid;
    }
  }
}
